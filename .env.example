# Carregue com: node --env-file=.env server/index.mjs
HOST=127.0.0.1
PORT=8000
PUBLIC_ORIGIN=http://localhost:8000
# [{"id":"rafa","sha256":"HASH_SHA256_DA_CREDENCIAL_INDIVIDUAL","roles":["admin"]}]
OPERATORS_JSON=[]
# sec_b64 do arquivo chave-emissao.json existente, nunca a chave pública
BADGE_SECRET_B64=
# 32 bytes aleatórios codificados em base64, para criptografar configuração da IA
SETTINGS_KEY=
# Armazenamento persistente, privado e com backup
DATA_DIR=.data
# Ative somente se um proxy confiável sobrescrever X-Real-IP e bloquear acesso direto
TRUST_PROXY=false

# Netlify: somente no contexto production; previews sem segredos de produção
CENTER_ENV=production

# Acesso por e-mail: manter no ambiente privado, não incluir os usuários no HTML
CENTER_MEMBERS_JSON=[]

# Administradores adicionais, separados por vírgula. Exige conta Identity confirmada.
CENTER_ADMIN_EMAILS=
